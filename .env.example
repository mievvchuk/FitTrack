# Local Docker Compose environment for FitTrack.
# Copy this file to .env and replace placeholder secrets before running Docker.

# Container ports exposed on the host machine.
API_PORT=8000
POSTGRES_PORT=5432

POSTGRES_DB=fittrack
POSTGRES_USER=fittrack
POSTGRES_PASSWORD=fittrack

# Backend runtime.
PORT=8000
DATABASE_URL=postgresql+psycopg://fittrack:fittrack@postgres:5432/fittrack
FIREBASE_PROJECT_ID=

# Stripe must use test keys only for this coursework project.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=fittrack://payment-success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=fittrack://payment-cancel
PREMIUM_PRICE_CENTS=999
PREMIUM_CURRENCY=usd

# JWT and account protection.
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=fittrack-api
JWT_AUDIENCE=fittrack-mobile
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_TOKEN_MINUTES=60
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# API protection.
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_STORAGE_URI=memory://
ALLOWED_HOSTS=["localhost","127.0.0.1","10.0.2.2","api","testserver"]
ALLOWED_ORIGINS=["http://localhost","http://127.0.0.1"]
ENFORCE_HTTPS=false
RUN_MIGRATIONS=true

# Notifications.
NOTIFICATIONS_ENABLED=true
FCM_DRY_RUN=true

# AI Fitness Assistant. Do not commit a real API key.
ZAI_API_KEY=zai_replace_me
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_CHAT_MODEL=glm-5.2
ZAI_TIMEOUT_SECONDS=30
