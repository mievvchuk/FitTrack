BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/fittrack-backend:latest
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql+psycopg://fittrack:replace-with-strong-postgres-password@postgres:5432/fittrack
FIREBASE_PROJECT_ID=fittrack-prod
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
JWT_SECRET_KEY=replace-with-long-random-production-secret
RATE_LIMIT_STORAGE_URI=memory://
ALLOWED_HOSTS=api.fittrack.example
ALLOWED_ORIGINS=https://fittrack.example
ENFORCE_HTTPS=true
RUN_MIGRATIONS=true
NOTIFICATIONS_ENABLED=true
FCM_DRY_RUN=false
ZAI_API_KEY=zai_replace_me
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_CHAT_MODEL=glm-5.2
ZAI_TIMEOUT_SECONDS=30
